  "query": "SELECT d.id, d.updated_at AS \"updated_at: jiff_sqlx::Timestamp\", ARRAY_AGG(dr.resolution) AS resolutions\nFROM download d\n         JOIN download_resolution dr ON d.id = dr.download_id\nWHERE d.variant = 'batch'\n  AND d.provider = $1\n  AND d.title = $2\n  AND d.start_index = $3\n  AND d.end_index = $4\nGROUP BY id",
